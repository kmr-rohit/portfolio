/*
 * Long-form article body. The measure is deliberately narrower than the page
 * container so paragraphs stay around 75 characters.
 */
.mdsvex {
	@apply max-w-prose;
}

/* Inline code inside prose. */
.mdsvex :where(p, li, td) > code,
.mdsvex :where(p, li, td) span[data-rehype-pretty-code-fragment] code {
	@apply rounded border border-foreground/10 bg-foreground/[0.04] px-1 py-0.5 font-mono text-[0.85em] text-foreground;
}

.mdsvex span[data-rehype-pretty-code-fragment] {
	@apply inline-flex w-fit;
}

/* Block code. Colours come from the Shiki theme; layout comes from here. */
.mdsvex [data-rehype-pretty-code-fragment] {
	@apply relative;
}

.mdsvex pre {
	@apply max-h-[32rem] overflow-auto py-4 font-mono text-[0.8125rem] leading-relaxed;
	scrollbar-width: thin;
}

.mdsvex pre code {
	@apply grid min-w-full border-0 bg-transparent p-0 text-inherit;
	counter-reset: line;
	box-decoration-break: clone;
}

.mdsvex pre code [data-line] {
	@apply inline-block w-full border-l-2 border-l-transparent px-4;
}

.mdsvex pre code [data-highlighted-line] {
	@apply border-l-amber-400/60 bg-amber-400/[0.07];
}

.mdsvex [data-line-numbers] > [data-line]::before {
	@apply mr-4 inline-block w-4 text-right text-white/25;
	counter-increment: line;
	content: counter(line);
}

.mdsvex [data-rehype-pretty-code-title] {
	@apply px-4 pt-4 font-mono text-2xs uppercase tracking-label text-white/40;
}

.mdsvex [data-chars-id] {
	@apply pb-0.5 shadow-none;
}

.mdsvex [data-chars-id='ul'] {
	@apply border-b border-b-emerald-400/70 !important;
}

.mdsvex [data-chars-id='hi'] {
	@apply rounded bg-teal-500/30 px-1 !important;
}

.mdsvex [data-chars-id='rb'] {
	@apply rounded border border-red-500/60 px-[2px] !important;
}

.mdsvex [data-chars-id='yb'] {
	@apply rounded border border-amber-500/60 px-[2px] !important;
}

.mdsvex [data-metadata]:not(:has(pre)) {
	display: none;
}

/* Tables occasionally show up in the serving posts for benchmark numbers. */
.mdsvex table {
	@apply my-8 w-full border-collapse text-sm;
}

.mdsvex th {
	@apply border-b py-2 pr-4 text-left font-medium text-foreground;
}

.mdsvex td {
	@apply border-b py-2 pr-4 align-top text-ink-70;
}

.mdsvex .katex-display {
	@apply my-8 overflow-x-auto overflow-y-hidden py-1;
}
