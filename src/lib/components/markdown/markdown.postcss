/*
 * Long-form essay body — Bearblog-inspired reading rhythm inside the site’s
 * paper/ink system. Serif for prose, Jost for UI chrome around it.
 */
.mdsvex {
	--ink-body: color-mix(in srgb, var(--ink) 82%, transparent);
	--read: 'Newsreader', 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;

	width: 100%;
	max-width: 42rem;
	min-width: 0;
	font-family: var(--read);
	font-size: clamp(1.05rem, 0.4vw + 1rem, 1.175rem);
	font-optical-sizing: auto;
	line-height: 1.7;
	letter-spacing: 0.005em;
	color: var(--ink-body);
	font-weight: 400;
}

.dark .mdsvex {
	--ink-body: color-mix(in srgb, var(--ink) 88%, transparent);
}

.mdsvex :where(p, li, td, th, blockquote) {
	font-family: var(--read);
}

.mdsvex :where(h1, h2, h3, h4, h5, h6) {
	font-family: var(--font);
	font-weight: 400;
	letter-spacing: var(--track-display);
	color: var(--ink);
	text-wrap: balance;
	line-height: 1.25;
}

.mdsvex strong,
.mdsvex b {
	color: var(--ink);
	font-weight: 600;
}

.mdsvex a {
	color: var(--ink);
	text-decoration: underline;
	text-decoration-color: color-mix(in srgb, var(--ink) 28%, transparent);
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
	transition: text-decoration-color 0.2s;
}

.mdsvex a:hover {
	text-decoration-color: color-mix(in srgb, var(--ink) 70%, transparent);
}

/* Inline code inside prose. */
.mdsvex :where(p, li, td) > code,
.mdsvex :where(p, li, td) span[data-rehype-pretty-code-fragment] code {
	font-family: 'Geist Mono', ui-monospace, monospace;
	font-size: 0.82em;
	font-weight: 450;
	padding: 0.12em 0.38em;
	border-radius: 3px;
	border: 1px solid var(--hairline);
	background: color-mix(in srgb, var(--ink) 4.5%, transparent);
	color: var(--ink);
	letter-spacing: 0;
}

.mdsvex span[data-rehype-pretty-code-fragment] {
	display: inline-flex;
	width: fit-content;
}

/* Block code — terminal panels. */
.mdsvex [data-rehype-pretty-code-fragment] {
	position: relative;
	margin-block: 1.75rem;
	max-width: 100%;
	min-width: 0;
}

.mdsvex pre {
	max-width: 100%;
	max-height: 32rem;
	overflow: auto;
	padding-block: 1rem;
	font-family: 'Geist Mono', ui-monospace, monospace;
	font-size: 0.8125rem;
	line-height: 1.65;
	letter-spacing: 0;
	scrollbar-width: thin;
	-webkit-overflow-scrolling: touch;
}

.mdsvex pre code {
	display: grid;
	min-width: 100%;
	border: 0;
	background: transparent;
	padding: 0;
	color: inherit;
	counter-reset: line;
	box-decoration-break: clone;
}

.mdsvex pre code [data-line] {
	display: inline-block;
	width: 100%;
	border-left: 2px solid transparent;
	padding-inline: 1rem;
}

.mdsvex pre code [data-highlighted-line] {
	border-left-color: color-mix(in srgb, #f5b942 60%, transparent);
	background: color-mix(in srgb, #f5b942 7%, transparent);
}

.mdsvex [data-line-numbers] > [data-line]::before {
	display: inline-block;
	width: 1rem;
	margin-right: 1rem;
	text-align: right;
	color: color-mix(in srgb, #fff 25%, transparent);
	counter-increment: line;
	content: counter(line);
}

.mdsvex [data-rehype-pretty-code-title] {
	padding: 1rem 1rem 0;
	font-family: 'Geist Mono', ui-monospace, monospace;
	font-size: 0.65rem;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	color: color-mix(in srgb, #fff 40%, transparent);
}

.mdsvex [data-chars-id] {
	padding-bottom: 0.125rem;
	box-shadow: none;
}

.mdsvex [data-chars-id='ul'] {
	border-bottom: 1px solid color-mix(in srgb, #34d399 70%, transparent) !important;
}

.mdsvex [data-chars-id='hi'] {
	border-radius: 2px;
	background: color-mix(in srgb, #14b8a6 30%, transparent) !important;
	padding-inline: 0.25rem !important;
}

.mdsvex [data-chars-id='rb'] {
	border-radius: 2px;
	border: 1px solid color-mix(in srgb, #ef4444 60%, transparent) !important;
	padding-inline: 2px !important;
}

.mdsvex [data-chars-id='yb'] {
	border-radius: 2px;
	border: 1px solid color-mix(in srgb, #f59e0b 60%, transparent) !important;
	padding-inline: 2px !important;
}

.mdsvex [data-metadata]:not(:has(pre)) {
	display: none;
}

/*
 * Unlabeled fences (ASCII architecture sketches) render as paper diagrams
 * rather than terminal chrome — closer to figure plates in a long essay.
 */
.essay .mdsvex .group:not(:has([data-language])) {
	background: color-mix(in srgb, var(--ink) 3.5%, var(--paper));
	border: 1px solid var(--hairline);
	border-radius: 2px;
	box-shadow: none;
}

.essay .mdsvex .group:not(:has([data-language])) pre,
.essay .mdsvex .group:not(:has([data-language])) code,
.essay .mdsvex .group:not(:has([data-language])) [data-line] {
	color: color-mix(in srgb, var(--ink) 88%, transparent) !important;
}

.essay .mdsvex .group:not(:has([data-language])) button {
	display: none;
}

.essay .mdsvex .group:not(:has([data-language])) pre {
	font-size: 0.72rem;
	line-height: 1.45;
	overflow-x: auto;
}

.dark .essay .mdsvex .group:not(:has([data-language])) {
	background: color-mix(in srgb, var(--ink) 6%, transparent);
}

/* Tables — compact reference boards. */
.mdsvex table {
	width: 100%;
	margin-block: 2rem;
	border-collapse: collapse;
	font-size: 0.9em;
	font-family: var(--font);
	letter-spacing: 0.01em;
	display: block;
	overflow-x: auto;
	-webkit-overflow-scrolling: touch;
}

.mdsvex th {
	padding: 0.55rem 0.85rem 0.55rem 0;
	text-align: left;
	font-weight: 500;
	font-size: 0.72em;
	letter-spacing: var(--track-nav);
	text-transform: uppercase;
	color: var(--ink-soft);
	border-bottom: 1px solid var(--hairline);
	white-space: nowrap;
}

.mdsvex td {
	padding: 0.65rem 0.85rem 0.65rem 0;
	vertical-align: top;
	color: var(--ink-body);
	border-bottom: 1px solid color-mix(in srgb, var(--hairline) 70%, transparent);
	font-variant-numeric: tabular-nums;
}

.mdsvex tr:last-child td {
	border-bottom-color: var(--hairline);
}

.mdsvex .katex-display {
	margin-block: 2rem;
	overflow-x: auto;
	overflow-y: hidden;
	padding-block: 0.25rem;
}

.mdsvex hr {
	border: 0;
	border-top: 1px dashed var(--hairline);
	margin-block: 2.5rem;
}

.mdsvex mark {
	background: color-mix(in srgb, var(--accent) 18%, transparent);
	color: var(--ink);
	padding: 0.05em 0.2em;
	border-radius: 2px;
}

/* Pasted-notebook sketch figures (Rough.js / Excalidraw SVGs). */
.sketch-figure {
	margin-block: 2rem;
	max-width: 100%;
}

.sketch-sheet {
	background:
		linear-gradient(135deg, rgba(255, 255, 255, 0.55), transparent 42%),
		color-mix(in srgb, var(--paper) 88%, #f3efe6);
	border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
	border-radius: 2px;
	box-shadow:
		0 1px 0 color-mix(in srgb, var(--ink) 4%, transparent),
		0 10px 28px -18px color-mix(in srgb, var(--ink) 35%, transparent);
	padding: 10px 10px 6px;
	transform: rotate(-0.35deg);
	overflow: hidden;
}

.dark .sketch-sheet {
	background:
		linear-gradient(135deg, rgba(255, 255, 255, 0.03), transparent 42%),
		color-mix(in srgb, var(--ink) 5%, #121316);
	border-color: color-mix(in srgb, var(--ink) 16%, transparent);
}

.sketch-sheet svg {
	display: block;
	width: 100%;
	height: auto;
	max-width: 100%;
}

.sketch-figure figcaption {
	margin-top: 0.7rem;
	font-family: 'Architects Daughter', 'Segoe Print', cursive;
	font-size: 1.05rem;
	font-weight: 700;
	letter-spacing: 0.01em;
	color: var(--ink-soft);
	text-align: center;
}

.mdsvex .sketch-figure {
	margin-inline: 0;
}
