/* Fonts are linked from app.html so they can preconnect and load in parallel. */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		/*
		 * Cool paper / ink — adapted from matthewyu.dev's design system.
		 * Soft blue-gray paper, near-black ink, periwinkle accent for blur hero.
		 */
		--paper: #e6e9ed;
		--ink: #1d1f22;
		--ink-soft: rgba(29, 31, 34, 0.55);
		--ink-body: rgba(29, 31, 34, 0.85);
		--hairline: rgba(29, 31, 34, 0.14);
		--ph: #d7dbe0;
		--accent: #3d6ced;
		--surface: #f4f6f8;
		--top-fade: rgba(230, 233, 237, 0.97);

		--background: 210 14% 91%;
		--foreground: 220 7% 12%;
		--card: 210 20% 96%;
		--card-foreground: 220 7% 12%;
		--popover: 210 20% 96%;
		--popover-foreground: 220 7% 12%;
		--primary: 220 7% 12%;
		--primary-foreground: 210 14% 91%;
		--secondary: 210 16% 94%;
		--secondary-foreground: 220 7% 12%;
		--muted: 210 16% 94%;
		--muted-foreground: 220 6% 40%;
		--accent-hsl: 221 80% 58%;
		--accent-foreground: 210 14% 91%;
		--destructive: 0 72% 45%;
		--destructive-foreground: 0 0% 100%;
		--border: 210 12% 84%;
		--input: 210 12% 84%;
		--ring: 220 7% 12%;
		--radius: 0.25rem;

		--track-caps: 0.24em;
		--track-nav: 0.12em;
		--track-display: 0.05em;
		--font-sans: 'Jost', 'Futura', 'Avenir Next', system-ui, sans-serif;
	}

	.dark {
		--paper: #060608;
		--ink: #f2f4f7;
		--ink-soft: rgba(242, 244, 247, 0.6);
		--ink-body: rgba(242, 244, 247, 0.82);
		--hairline: rgba(242, 244, 247, 0.18);
		--ph: #1a1b1f;
		--accent: #6b8ef5;
		--surface: #121316;
		--top-fade: rgba(6, 6, 8, 0.97);

		--background: 240 7% 2%;
		--foreground: 210 20% 96%;
		--card: 240 6% 7%;
		--card-foreground: 210 20% 96%;
		--popover: 240 6% 7%;
		--popover-foreground: 210 20% 96%;
		--primary: 210 20% 96%;
		--primary-foreground: 240 7% 2%;
		--secondary: 240 5% 12%;
		--secondary-foreground: 210 20% 96%;
		--muted: 240 5% 12%;
		--muted-foreground: 210 10% 65%;
		--accent-hsl: 221 80% 68%;
		--accent-foreground: 240 7% 2%;
		--destructive: 0 62% 45%;
		--destructive-foreground: 210 20% 96%;
		--border: 240 5% 16%;
		--input: 240 5% 16%;
		--ring: 210 20% 96%;
	}
}

@layer base {
	* {
		@apply border-border;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 6rem;
		-webkit-text-size-adjust: 100%;
		overflow-x: clip;
	}

	body {
		font-family: var(--font-sans);
		font-weight: 400;
		background: var(--paper);
		color: var(--ink);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		overflow-x: clip;
		transition: background-color 0.55s ease, color 0.35s ease;
	}

	::selection {
		background: rgba(29, 31, 34, 0.85);
		color: var(--paper);
	}

	.dark ::selection {
		background: rgba(242, 244, 247, 0.88);
		color: var(--paper);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		color: var(--ink);
		text-wrap: balance;
		font-weight: 400;
	}

	:focus-visible {
		outline: 1.5px solid color-mix(in srgb, var(--ink) 40%, transparent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}
}

@layer components {
	.page-shell {
		min-height: 100dvh;
		max-width: 980px;
		margin-inline: auto;
		padding: calc(clamp(28px, 5vw, 72px) + 56px) clamp(28px, 5vw, 72px) 10vh;
		animation: page-fade 0.45s ease both;
	}

	.page-shell.home {
		padding-bottom: clamp(28px, 5vh, 56px);
	}

	.section-label {
		font-size: 11px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 20px;
	}

	.link {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
		font-weight: 500;
		transition: text-decoration-color 0.2s ease;
	}

	.link:hover {
		text-decoration-color: var(--ink);
	}

	.link-quiet {
		color: var(--ink-soft);
		transition: color 0.2s ease;
	}

	.link-quiet:hover {
		color: var(--ink);
	}

	.rule {
		border: 0;
		border-top: 1px solid var(--hairline);
	}

	/* —— Top bar (frosted fade) —— */
	.site-top {
		position: fixed;
		inset: 0 0 auto;
		z-index: 500;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-inline: clamp(20px, 4vw, 48px);
		padding-block: 16px 72px;
		pointer-events: none;
	}

	.site-top > * {
		pointer-events: auto;
	}

	.site-top::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			180deg,
			var(--top-fade),
			color-mix(in srgb, var(--paper) 90%, transparent) 45%,
			transparent
		);
		-webkit-backdrop-filter: blur(16px) saturate(0.9);
		backdrop-filter: blur(16px) saturate(0.9);
		-webkit-mask-image: linear-gradient(180deg, #000 42%, transparent);
		mask-image: linear-gradient(180deg, #000 42%, transparent);
	}

	.site-top .brand {
		font-size: 15px;
		font-weight: 300;
		letter-spacing: var(--track-nav);
		white-space: nowrap;
		color: var(--ink);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 13px;
		letter-spacing: var(--track-nav);
	}

	.site-nav a {
		color: var(--ink-soft);
		transition: color 0.2s ease;
		text-transform: lowercase;
	}

	.site-nav a:hover,
	.site-nav a[aria-current='page'] {
		color: var(--ink);
	}

	.site-socials {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-left: 12px;
		padding-left: 20px;
		border-left: 1px solid var(--hairline);
	}

	/* —— Hero —— */
	.hero {
		position: relative;
		display: grid;
		justify-items: center;
		align-content: center;
		margin-top: calc(-1 * (clamp(28px, 5vw, 72px) + 56px));
		min-height: 100svh;
		padding-bottom: clamp(48px, 7svh, 66px);
	}

	.hero-kicker {
		font-size: 11.5px;
		font-weight: 300;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		text-align: center;
		color: var(--ink-soft);
		margin-bottom: clamp(18px, 3vh, 34px);
	}

	.hero-name {
		position: relative;
		z-index: 0;
		font-weight: 500;
		font-size: clamp(52px, 10.5vw, 112px);
		letter-spacing: var(--track-display);
		color: var(--accent);
		filter: blur(6px);
		text-align: center;
		line-height: 1;
		white-space: nowrap;
		margin-bottom: -0.48em;
		user-select: none;
		pointer-events: none;
	}

	.hero-stage {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 20px;
		width: min(100%, 420px);
	}

	.hero-portrait {
		position: relative;
		width: min(72vw, 280px);
		display: grid;
		justify-items: center;
		gap: 20px;
	}

	.hero-portrait::before {
		content: '';
		position: absolute;
		left: 12%;
		right: 12%;
		top: 10%;
		bottom: 2%;
		border-radius: 18px;
		background: rgba(20, 22, 30, 0.18);
		filter: blur(28px);
		z-index: -1;
	}

	.hero-portrait img {
		width: 100%;
		border-radius: 4px;
		box-shadow: 0 18px 48px rgba(20, 22, 30, 0.22);
	}

	.hero-caption {
		font-size: 12px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.hero-down {
		position: absolute;
		bottom: 44px;
		left: 50%;
		transform: translateX(-50%);
		border: 0;
		background: transparent;
		padding: 10px 14px;
		color: var(--ink);
		cursor: pointer;
		animation: cue-breathe 2.6s ease-in-out infinite;
	}

	.hero-down:hover {
		animation: none;
		opacity: 1;
	}

	/* —— About band —— */
	.about-band {
		display: grid;
		grid-template-columns: auto auto;
		justify-content: center;
		align-items: center;
		gap: clamp(24px, 4vw, 44px);
		margin-top: clamp(16px, 4vh, 48px);
		margin-bottom: clamp(64px, 11vh, 140px);
	}

	.about-bio {
		max-width: 480px;
		font-size: 15px;
		line-height: 1.95;
		letter-spacing: 0.025em;
		color: var(--ink-body);
	}

	.about-headshot {
		width: clamp(96px, 14vw, 132px);
	}

	.about-headshot img {
		width: 100%;
		border-radius: 4px;
		box-shadow: 0 10px 28px rgba(20, 22, 30, 0.16);
	}

	/* —— Project / writing rows —— */
	.rows {
		border-top: 1px solid var(--hairline);
	}

	.row {
		position: relative;
		display: grid;
		grid-template-columns: 3.2em 1fr auto;
		align-items: baseline;
		gap: 16px;
		padding: 17px 2px;
		border-bottom: 1px solid var(--hairline);
		transition: opacity 0.15s ease;
		color: inherit;
	}

	.rows:hover .row:not(:hover) {
		opacity: 0.45;
	}

	.row .year {
		font-size: 12px;
		color: var(--ink-soft);
		letter-spacing: var(--track-nav);
	}

	.row .title {
		font-size: clamp(17px, 2vw, 21px);
		letter-spacing: 0.03em;
	}

	.row .blurb {
		font-size: 13px;
		color: var(--ink-soft);
		letter-spacing: 0.03em;
		text-align: right;
		text-transform: lowercase;
	}

	.row-thumb {
		position: absolute;
		right: 7.5em;
		top: 50%;
		width: min(220px, 42vw);
		transform: translateY(-50%) scale(0.92);
		border-radius: 4px;
		overflow: hidden;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		border: 1px solid var(--hairline);
		box-shadow: 0 12px 34px rgba(20, 22, 30, 0.24);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.22s ease, transform 0.22s ease;
		z-index: 6;
		padding: 12px 14px;
	}

	.row-thumb.has-image {
		width: 116px;
		aspect-ratio: 3 / 2;
		padding: 0;
	}

	.row-thumb.has-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.row-thumb .preview-title {
		font-size: 13px;
		letter-spacing: 0.02em;
		margin-bottom: 6px;
		color: var(--ink);
	}

	.row-thumb .preview-body {
		font-size: 12px;
		line-height: 1.55;
		color: var(--ink-soft);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row:hover .row-thumb {
		opacity: 1;
		transform: translateY(-50%) scale(1);
	}

	/* —— Page headers / article —— */
	.page-head {
		margin-bottom: clamp(32px, 6vh, 64px);
	}

	.page-head h1 {
		font-weight: 300;
		font-size: clamp(30px, 5vw, 54px);
		letter-spacing: var(--track-display);
	}

	.page-head .lede {
		margin-top: 14px;
		max-width: 620px;
		font-size: 15.5px;
		line-height: 1.75;
		letter-spacing: 0.02em;
		color: var(--ink-body);
	}

	.page-head .meta {
		margin-top: 10px;
		font-size: 13px;
		color: var(--ink-soft);
		letter-spacing: var(--track-nav);
	}

	.back-link {
		display: inline-block;
		font-size: 13px;
		letter-spacing: var(--track-nav);
		color: var(--ink-soft);
		transition: color 0.2s ease;
		margin-bottom: clamp(24px, 4vh, 40px);
	}

	.back-link:hover {
		color: var(--ink);
	}

	.site-foot {
		font-size: 11px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
		text-align: center;
		padding-top: 4vh;
	}

	.play-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: clamp(14px, 2vw, 26px);
	}

	.play-card .thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 3px;
		background: var(--ph);
	}

	.play-card .thumb-fallback {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 300;
		letter-spacing: var(--track-display);
		color: var(--ink-soft);
		background:
			radial-gradient(120% 80% at 20% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 55%),
			var(--ph);
	}

	.play-card .cap {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-top: 11px;
		gap: 12px;
	}

	.play-card .cap .t {
		font-size: 16px;
		letter-spacing: 0.03em;
	}

	.play-card .cap .n {
		font-size: 12px;
		color: var(--ink-soft);
		letter-spacing: 0.02em;
		text-align: right;
	}

	.play-card:hover .thumb-fallback {
		filter: blur(0.2px);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		margin-top: clamp(48px, 8vh, 96px);
		padding-top: 20px;
		border-top: 1px solid var(--hairline);
		font-size: 13px;
		letter-spacing: var(--track-nav);
		color: var(--ink-soft);
	}

	.pager a:hover {
		color: var(--ink);
	}

	.prose-block {
		max-width: 620px;
		display: grid;
		gap: 1.1em;
		font-size: 15.5px;
		line-height: 1.75;
		letter-spacing: 0.02em;
		color: var(--ink-body);
	}
}

@layer utilities {
	.no-highlight {
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
	}

	.tnum {
		font-variant-numeric: tabular-nums;
	}

	.track-caps {
		letter-spacing: var(--track-caps);
	}

	.track-nav {
		letter-spacing: var(--track-nav);
	}
}

@keyframes page-fade {
	from {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}

@keyframes cue-breathe {
	0%,
	100% {
		opacity: 0.15;
	}
	50% {
		opacity: 0.75;
	}
}

@media (max-width: 640px) {
	.site-top {
		padding-inline: 12px;
		padding-block: 12px 56px;
	}

	.site-top .brand {
		font-size: 12px;
	}

	.site-nav {
		gap: 10px;
		font-size: 11px;
		letter-spacing: 0.07em;
	}

	.site-socials {
		gap: 8px;
		margin-left: 0;
		padding-left: 10px;
	}

	.row {
		grid-template-columns: 3em 1fr;
	}

	.row .blurb,
	.row-thumb {
		display: none;
	}

	.about-band {
		grid-template-columns: 1fr;
		gap: 22px;
	}

	.about-headshot {
		order: -1;
	}

	.hero-name {
		white-space: normal;
		font-size: clamp(42px, 14vw, 64px);
		filter: blur(5px);
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	.page-shell,
	.hero-down,
	.row,
	.row-thumb {
		animation: none !important;
		transition: none !important;
	}

	.hero-down {
		opacity: 0.5;
	}

	.hero-name {
		filter: blur(4px);
	}
}
