/* Fonts are linked from app.html so they can preconnect and load in parallel. */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		/* Warm paper / ink palette. #fdfcfb on #1a180f. */
		--background: 30 33% 99%;
		--foreground: 45 27% 8%;
		--card: 30 33% 99%;
		--card-foreground: 45 27% 8%;
		--popover: 30 33% 99%;
		--popover-foreground: 45 27% 8%;
		--primary: 45 27% 8%;
		--primary-foreground: 30 33% 99%;
		--secondary: 40 14% 94%;
		--secondary-foreground: 45 27% 8%;
		--muted: 40 14% 94%;
		--muted-foreground: 45 8% 45%;
		--accent: 40 14% 94%;
		--accent-foreground: 45 27% 8%;
		--destructive: 0 72% 45%;
		--destructive-foreground: 30 33% 99%;
		--border: 40 12% 88%;
		--input: 40 12% 88%;
		--ring: 45 27% 8%;
		--radius: 0.375rem;

		--rule: 0 0 0;
		--surface: 40 16% 96%;
	}

	.dark {
		/* #161513 on #ece9e3. */
		--background: 40 7% 8%;
		--foreground: 40 19% 91%;
		--card: 40 7% 8%;
		--card-foreground: 40 19% 91%;
		--popover: 40 7% 8%;
		--popover-foreground: 40 19% 91%;
		--primary: 40 19% 91%;
		--primary-foreground: 40 7% 8%;
		--secondary: 40 6% 14%;
		--secondary-foreground: 40 19% 91%;
		--muted: 40 6% 14%;
		--muted-foreground: 40 8% 60%;
		--accent: 40 6% 14%;
		--accent-foreground: 40 19% 91%;
		--destructive: 0 62% 45%;
		--destructive-foreground: 40 19% 91%;
		--border: 40 6% 18%;
		--input: 40 6% 18%;
		--ring: 40 19% 91%;

		--rule: 255 255 255;
		--surface: 40 6% 11%;
	}
}

@layer base {
	* {
		@apply border-border;
	}

	html {
		scroll-behavior: smooth;
		/* Anchored headings should not hide under the sticky header. */
		scroll-padding-top: 6rem;
		-webkit-text-size-adjust: 100%;
	}

	body {
		@apply bg-background text-ink-70 antialiased;
		font-feature-settings: 'cv05' 1, 'cv08' 1, 'ss01' 1;
		text-rendering: optimizeLegibility;
	}

	::selection {
		@apply bg-foreground/10;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		@apply text-foreground;
		text-wrap: balance;
	}
}

@layer components {
	/*
	 * The single link treatment used across the whole site: a hairline underline
	 * that only gains contrast on hover.
	 */
	.link {
		@apply underline decoration-1 underline-offset-4 transition-colors;
		text-decoration-color: rgb(var(--rule) / 0.25);
	}

	.link:hover {
		text-decoration-color: rgb(var(--rule) / 0.6);
	}

	.link-quiet {
		@apply no-underline decoration-1 underline-offset-4 transition-colors hover:underline;
		text-decoration-color: rgb(var(--rule) / 0.4);
	}

	.rule {
		@apply border-0 border-t;
		border-color: rgb(var(--rule) / 0.1);
	}
}

@layer utilities {
	.no-highlight {
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
	}

	/* Renders long numeric columns (dates, read times) with even spacing. */
	.tnum {
		font-variant-numeric: tabular-nums;
	}
}
