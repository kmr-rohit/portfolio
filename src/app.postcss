/* Design system adapted from matthewyu.dev stylesheet (tokens + layout).
 * Typeface: Jost as the open Futura stand-in — we do not hotlink his font files. */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		--paper: #e6e9ed;
		--ink: #1d1f22;
		--ink-soft: rgba(29, 31, 34, 0.55);
		--hairline: rgba(29, 31, 34, 0.14);
		--ph: #d7dbe0;
		--accent: #3d6ced;
		--font: 'Jost', 'Futura', 'Avenir Next', system-ui, sans-serif;
		--track-caps: 0.24em;
		--track-nav: 0.12em;
		--track-display: 0.05em;

		/* Kept for Tailwind / markdown utilities that still reference HSL tokens. */
		--background: 210 14% 91%;
		--foreground: 220 7% 12%;
		--card: 210 20% 96%;
		--card-foreground: 220 7% 12%;
		--popover: 210 20% 96%;
		--popover-foreground: 220 7% 12%;
		--primary: 220 7% 12%;
		--primary-foreground: 210 14% 91%;
		--secondary: 210 16% 94%;
		--secondary-foreground: 220 7% 12%;
		--muted: 210 16% 94%;
		--muted-foreground: 220 6% 40%;
		--accent-hsl: 221 80% 58%;
		--accent-foreground: 210 14% 91%;
		--destructive: 0 72% 45%;
		--destructive-foreground: 0 0% 100%;
		--border: 210 12% 84%;
		--input: 210 12% 84%;
		--ring: 220 7% 12%;
		--radius: 0.25rem;
		--surface: #f4f6f8;
	}

	.dark {
		--paper: #060608;
		--ink: #f2f4f7;
		--ink-soft: rgba(242, 244, 247, 0.6);
		--hairline: rgba(242, 244, 247, 0.18);
		--ph: #1a1b1f;
		--accent: #6b8ef5;
		--surface: #121316;

		--background: 240 7% 2%;
		--foreground: 210 20% 96%;
		--card: 240 6% 7%;
		--card-foreground: 210 20% 96%;
		--popover: 240 6% 7%;
		--popover-foreground: 210 20% 96%;
		--primary: 210 20% 96%;
		--primary-foreground: 240 7% 2%;
		--secondary: 240 5% 12%;
		--secondary-foreground: 210 20% 96%;
		--muted: 240 5% 12%;
		--muted-foreground: 210 10% 65%;
		--accent-hsl: 221 80% 68%;
		--accent-foreground: 240 7% 2%;
		--destructive: 0 62% 45%;
		--destructive-foreground: 210 20% 96%;
		--border: 240 5% 16%;
		--input: 240 5% 16%;
		--ring: 210 20% 96%;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 96px;
		overflow-x: clip;
		-webkit-text-size-adjust: 100%;
	}

	body,
	html {
		overflow-x: clip;
	}

	body {
		font-family: var(--font);
		font-weight: 400;
		background: var(--paper);
		color: var(--ink);
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.55s ease;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	::selection {
		background: rgba(29, 29, 31, 0.85);
		color: var(--paper);
	}

	.dark ::selection {
		background: rgba(242, 244, 247, 0.88);
		color: #060608;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		color: var(--ink);
		text-wrap: balance;
		font-weight: 400;
	}

	:focus-visible {
		outline: 1.5px solid color-mix(in srgb, var(--ink) 40%, transparent);
		outline-offset: 3px;
		border-radius: 2px;
	}
}

@layer components {
	/* —— Page shell —— */
	.page {
		min-height: 100dvh;
		min-width: 0;
		width: 100%;
		padding: calc(clamp(28px, 5vw, 72px) + 56px) clamp(28px, 5vw, 72px) 10vh;
		max-width: 980px;
		margin: 0 auto;
		animation: page-fade 0.45s ease both;
	}

	.page.home {
		padding-bottom: clamp(28px, 5vh, 56px);
	}

	.page.home .foot {
		margin-top: clamp(40px, 8vh, 90px);
	}

	section {
		scroll-margin-top: 96px;
		margin-bottom: clamp(64px, 11vh, 140px);
	}

	.section-label {
		font-size: 11px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 20px;
	}

	/* —— Top bar —— */
	.top {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 500;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px 20px;
		padding-inline: clamp(20px, 4vw, 48px);
		padding-block: 16px 72px;
		pointer-events: none;
	}

	.top > * {
		pointer-events: auto;
	}

	.top::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			180deg,
			rgba(230, 233, 237, 0.97),
			rgba(230, 233, 237, 0.9) 45%,
			rgba(230, 233, 237, 0)
		);
		-webkit-backdrop-filter: blur(16px) saturate(0.9);
		backdrop-filter: blur(16px) saturate(0.9);
		-webkit-mask-image: linear-gradient(180deg, #000 42%, transparent);
		mask-image: linear-gradient(180deg, #000 42%, transparent);
	}

	.dark .top::before {
		background: linear-gradient(
			180deg,
			rgba(6, 6, 8, 0.97),
			rgba(6, 6, 8, 0.9) 45%,
			rgba(6, 6, 8, 0)
		);
		-webkit-backdrop-filter: blur(16px) saturate(0.9);
		backdrop-filter: blur(16px) saturate(0.9);
	}

	.top .name {
		font-size: 15px;
		font-weight: 300;
		white-space: nowrap;
		flex: none;
		letter-spacing: var(--track-nav);
		color: var(--ink);
	}

	.top nav {
		display: flex;
		gap: 22px;
		font-size: 13px;
		align-items: center;
		letter-spacing: var(--track-nav);
		min-width: 0;
		margin-left: auto;
	}

	.top nav a {
		color: var(--ink-soft);
		transition: color 0.2s;
		text-transform: lowercase;
		white-space: nowrap;
		padding-block: 4px;
	}

	.top nav a:hover,
	.top nav a[aria-current='page'] {
		color: var(--ink);
	}

	.top .top-socials {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-left: 12px;
		padding-left: 20px;
		border-left: 1px solid var(--hairline);
		flex: none;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 4px;
		color: var(--ink-soft);
		transition: color 0.2s;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.icon-btn:hover {
		color: var(--ink);
	}

	/* —— Links —— */
	.link,
	.bio-link {
		font-weight: 500;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: rgba(29, 29, 31, 0.25);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.2s;
	}

	.dark .link,
	.dark .bio-link {
		text-decoration-color: rgba(242, 244, 247, 0.28);
	}

	.link:hover,
	.bio-link:hover {
		text-decoration-color: var(--ink);
	}

	.link-quiet {
		color: var(--ink-soft);
		transition: color 0.2s;
	}

	.link-quiet:hover {
		color: var(--ink);
	}

	.rule {
		border: 0;
		border-top: 1px solid var(--hairline);
	}

	.back {
		display: inline-block;
		font-size: 13px;
		letter-spacing: var(--track-nav);
		color: var(--ink-soft);
		transition: color 0.2s;
		margin-bottom: clamp(24px, 4vh, 40px);
	}

	.back:hover {
		color: var(--ink);
	}

	/* —— Hero —— */
	.hero {
		position: relative;
		display: grid;
		justify-items: center;
		align-content: center;
		margin-top: calc(-1 * (clamp(28px, 5vw, 72px) + 56px));
		min-height: 100svh;
		padding-bottom: clamp(48px, 7svh, 66px);
		overflow-anchor: none;
		margin-bottom: 0;
	}

	.hero-kicker {
		font-size: 11.5px;
		font-weight: 300;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		text-align: center;
		color: var(--ink-soft);
		margin-bottom: clamp(18px, 3vh, 34px);
	}

	.hero-name {
		position: relative;
		z-index: 0;
		font-weight: 500;
		font-size: clamp(56px, 11vw, 118px);
		letter-spacing: var(--track-display);
		color: var(--accent);
		filter: blur(6px);
		text-align: center;
		line-height: 1;
		white-space: nowrap;
		margin-bottom: -0.52em;
		user-select: none;
		pointer-events: none;
	}

	.hero-stage {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 20px;
		width: min(100%, 420px);
	}

	.hero-portrait {
		position: relative;
		width: min(68vw, 300px);
		display: grid;
		justify-items: center;
		gap: 20px;
	}

	/* Soft under-glow — same trick as .sb-book:before */
	.hero-portrait::before {
		content: '';
		position: absolute;
		left: 10%;
		right: 10%;
		top: 8%;
		bottom: 16%;
		border-radius: 18px;
		background: rgba(20, 22, 30, 0.18);
		filter: blur(28px);
		z-index: -1;
	}

	.hero-portrait img {
		width: 100%;
		border-radius: 4px;
		box-shadow: 0 18px 48px rgba(20, 22, 30, 0.22);
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center 18%;
	}

	.hero-caption {
		font-size: 12px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.hero-down {
		position: absolute;
		bottom: 44px;
		left: 50%;
		transform: translateX(-50%);
		border: 0;
		background: transparent;
		padding: 10px 14px;
		color: var(--ink);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		animation: cue-breathe 2.6s ease-in-out infinite;
	}

	.hero-down:hover {
		animation: none;
		opacity: 1;
	}

	/* —— About band —— */
	.about {
		display: grid;
		grid-template-columns: auto auto;
		justify-content: center;
		align-items: center;
		gap: clamp(24px, 4vw, 44px);
		margin-top: clamp(16px, 4vh, 48px);
	}

	.about-text .bio {
		max-width: 480px;
		font-size: 15px;
		line-height: 1.95;
		letter-spacing: 0.025em;
		color: rgba(29, 31, 34, 0.85);
		text-align: left;
	}

	.dark .about-text .bio {
		color: rgba(242, 244, 247, 0.82);
	}

	.about .headshot {
		width: clamp(96px, 14vw, 132px);
		flex: none;
	}

	.about .headshot img {
		width: 100%;
		height: auto;
		border-radius: 4px;
	}

	/* —— Project / writing rows —— */
	.rows {
		border-top: 1px solid var(--hairline);
	}

	.row {
		position: relative;
		display: grid;
		grid-template-columns: 3.2em 1fr auto;
		align-items: baseline;
		gap: 16px;
		padding: 17px 2px;
		border-bottom: 1px solid var(--hairline);
		transition: opacity 0.15s;
		color: inherit;
	}

	.row-thumb {
		position: absolute;
		right: 7.5em;
		top: 50%;
		width: 116px;
		aspect-ratio: 3 / 2;
		transform: translateY(-50%) scale(0.9);
		border-radius: 3px;
		overflow: hidden;
		background: var(--ph);
		box-shadow: 0 12px 34px rgba(20, 22, 30, 0.24);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.22s ease, transform 0.22s ease;
		z-index: 6;
	}

	.row-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Text preview when a post has no image — glass card instead of empty ph. */
	.row-thumb.is-text {
		width: min(220px, 42vw);
		aspect-ratio: auto;
		padding: 12px 14px;
		background: rgba(238, 241, 244, 0.72);
		border: 1px solid var(--hairline);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
	}

	.dark .row-thumb.is-text {
		background: rgba(18, 18, 22, 0.72);
	}

	.row-thumb .preview-title {
		font-size: 13px;
		letter-spacing: 0.02em;
		margin-bottom: 6px;
		color: var(--ink);
	}

	.row-thumb .preview-body {
		font-size: 12px;
		line-height: 1.55;
		color: var(--ink-soft);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row:hover .row-thumb {
		opacity: 1;
		transform: translateY(-50%) scale(1);
	}

	.row .year {
		font-size: 12px;
		color: var(--ink-soft);
		letter-spacing: var(--track-nav);
	}

	.row .title {
		font-size: clamp(17px, 2vw, 21px);
		letter-spacing: 0.03em;
	}

	.row .blurb {
		font-size: 13px;
		color: var(--ink-soft);
		letter-spacing: 0.03em;
		text-align: right;
		text-transform: lowercase;
	}

	.rows:hover .row:not(:hover) {
		opacity: 0.45;
	}

	/* —— Project / article headers —— */
	.proj-head {
		margin-bottom: clamp(32px, 6vh, 64px);
	}

	.proj-head h1 {
		font-weight: 300;
		font-size: clamp(30px, 5vw, 54px);
		letter-spacing: var(--track-display);
	}

	.proj-head .meta {
		margin-top: 10px;
		font-size: 13px;
		color: var(--ink-soft);
		letter-spacing: var(--track-nav);
	}

	.proj-head .lede,
	.proj-body {
		max-width: 620px;
		display: grid;
		gap: 1.1em;
		font-size: 15.5px;
		line-height: 1.75;
		letter-spacing: 0.02em;
		color: rgba(29, 29, 31, 0.82);
	}

	.dark .proj-head .lede,
	.dark .proj-body {
		color: rgba(242, 244, 247, 0.82);
	}

	.proj-head .lede {
		margin-top: 14px;
	}

	.proj-body {
		margin-bottom: clamp(40px, 7vh, 80px);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		margin-top: clamp(48px, 8vh, 96px);
		padding-top: 20px;
		border-top: 1px solid var(--hairline);
		font-size: 13px;
		letter-spacing: var(--track-nav);
		color: var(--ink-soft);
	}

	.pager a:hover {
		color: var(--ink);
	}

	/* —— Essay / writing article (Bearblog-inspired reading frame) —— */
	.essay {
		width: 100%;
		max-width: 42rem;
		min-width: 0;
		margin-inline: auto;
		animation: essay-rise 0.55s ease both;
	}

	.essay-head {
		margin-bottom: 0;
	}

	.essay-kicker {
		font-family: var(--font);
		font-size: 11px;
		font-weight: 400;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 14px;
	}

	.essay-head h1 {
		font-family: var(--font);
		font-weight: 300;
		font-size: clamp(1.55rem, 6.5vw, 2.65rem);
		letter-spacing: var(--track-display);
		line-height: 1.15;
		text-wrap: balance;
		overflow-wrap: anywhere;
		color: var(--ink);
		margin: 0;
	}

	.essay-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.15rem;
		margin-top: 16px;
		font-family: 'Geist Mono', ui-monospace, monospace;
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--ink-soft);
	}

	.essay-meta time {
		font-style: normal;
	}

	.essay-dot {
		margin-inline: 0.45rem;
		opacity: 0.55;
	}

	.essay-standfirst {
		margin-top: 22px;
		max-width: 38rem;
		font-family: 'Newsreader', 'Iowan Old Style', Palatino, Georgia, serif;
		font-size: clamp(1.05rem, 0.35vw + 1rem, 1.2rem);
		font-style: italic;
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--ink) 72%, transparent);
		text-wrap: pretty;
	}

	.essay-rule {
		height: 0;
		margin-block: clamp(28px, 5vh, 40px);
		border: 0;
		border-top: 1px dashed var(--hairline);
	}

	.essay-body {
		/* measure comes from .mdsvex; keep a hook for essay-only tweaks */
		position: relative;
	}

	.essay-body > :first-child {
		margin-top: 0;
	}

	.essay-foot {
		margin-top: clamp(40px, 7vh, 64px);
		padding-top: 20px;
		border-top: 1px dashed var(--hairline);
	}

	.essay-foot-note {
		font-family: 'Newsreader', Georgia, serif;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 36rem;
	}

	@keyframes essay-rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.essay {
			animation: none;
		}
	}

	.essay-index-head {
		margin-bottom: clamp(36px, 6vh, 56px);
		max-width: 42rem;
	}

	.essay-index-head h1 {
		font-weight: 300;
		font-size: clamp(30px, 5vw, 54px);
		letter-spacing: var(--track-display);
	}

	.essay-index-lede {
		margin-top: 14px;
		font-family: 'Newsreader', Georgia, serif;
		font-size: clamp(1.02rem, 0.3vw + 0.95rem, 1.12rem);
		line-height: 1.65;
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--ink) 72%, transparent);
		max-width: 36rem;
	}

	.essay-list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: 42rem;
		border-top: 1px solid var(--hairline);
	}

	.essay-list > li {
		border-bottom: 1px solid var(--hairline);
	}

	.essay-list-item {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 18px 28px;
		padding-block: 22px;
		align-items: start;
		transition: opacity 0.2s ease;
	}

	.essay-list-item:hover {
		opacity: 0.72;
	}

	.essay-list-date {
		font-family: 'Geist Mono', ui-monospace, monospace;
		font-size: 12px;
		letter-spacing: 0.04em;
		color: var(--ink-soft);
		padding-top: 5px;
	}

	.essay-list-main {
		display: grid;
		gap: 6px;
		min-width: 0;
	}

	.essay-list-title {
		font-family: var(--font);
		font-size: clamp(1.05rem, 0.4vw + 1rem, 1.2rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 1.35;
		color: var(--ink);
		text-wrap: balance;
	}

	.essay-list-desc {
		font-family: 'Newsreader', Georgia, serif;
		font-size: 0.98rem;
		line-height: 1.55;
		color: color-mix(in srgb, var(--ink) 68%, transparent);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.essay-list-meta {
		font-family: var(--font);
		font-size: 11px;
		letter-spacing: var(--track-nav);
		text-transform: lowercase;
		color: var(--ink-soft);
		margin-top: 2px;
	}

	@media (max-width: 640px) {
		.essay-list-item {
			grid-template-columns: 1fr;
			gap: 6px;
			padding-block: 18px;
		}

		.essay-list-date {
			padding-top: 0;
		}
	}

	/* —— Studio-style grid —— */
	.play-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: clamp(14px, 2vw, 26px);
	}

	.play-list + .section-label {
		margin-top: clamp(64px, 11vh, 140px);
	}

	.play-card .thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 3px;
		background: var(--ph);
	}

	.play-card .thumb img {
		transition: transform 0.5s ease;
	}

	.play-card:hover .thumb img {
		transform: scale(1.04);
	}

	.play-card .thumb-fallback {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 300;
		letter-spacing: var(--track-display);
		color: var(--ink-soft);
		background:
			radial-gradient(
				120% 80% at 20% 0%,
				color-mix(in srgb, var(--accent) 18%, transparent),
				transparent 55%
			),
			var(--ph);
	}

	.play-card .cap {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-top: 11px;
		gap: 12px;
	}

	.play-card .cap .t {
		font-size: 16px;
		letter-spacing: 0.03em;
	}

	.play-card .cap .n {
		font-size: 12px;
		color: var(--ink-soft);
		letter-spacing: 0.02em;
		text-align: right;
	}

	.foot {
		font-size: 11px;
		letter-spacing: var(--track-caps);
		text-transform: uppercase;
		color: var(--ink-soft);
		text-align: center;
		padding-top: 4vh;
	}

	/* —— Life mood board —— */
	/* Tokens on the root so the fixed header (outside .page) inherits light ink. */
	.life-root {
		--paper: #060608;
		--ink: #f2f4f7;
		--ink-soft: rgba(242, 244, 247, 0.6);
		--hairline: rgba(242, 244, 247, 0.18);
		--ph: #121316;
		--surface: #121316;
		background: #060608;
		color: var(--ink);
	}

	.life-root .top::before {
		background: linear-gradient(
			180deg,
			rgba(6, 6, 8, 0.97),
			rgba(6, 6, 8, 0.9) 45%,
			rgba(6, 6, 8, 0)
		);
	}

	.page.dark,
	.page.life-page {
		--ink: #f2f4f7;
		--ink-soft: rgba(242, 244, 247, 0.6);
		--hairline: rgba(242, 244, 247, 0.18);
		color: var(--ink);
		max-width: none;
		padding-inline: 0;
		padding-bottom: 0;
		padding-top: calc(clamp(28px, 5vw, 72px) + 40px);
		background: #060608;
		overflow-x: clip;
	}

	.life {
		width: 100%;
		min-height: calc(100svh - 4rem);
		padding: clamp(12px, 2vw, 28px) clamp(12px, 3vw, 24px) 12vh;
		columns: 220px 4;
		column-gap: 10px;
	}

	.life-card {
		break-inside: avoid;
		page-break-inside: avoid;
		margin: 0 0 10px;
		position: relative;
		z-index: var(--z, 1);
		transform: translateX(var(--shift, 0)) rotate(var(--rot, 0deg));
		border-radius: 2px;
		overflow: hidden;
		background: #121316;
		animation: page-fade 0.55s ease both;
		animation-delay: var(--delay, 0ms);
		transition: transform 0.35s ease, filter 0.35s ease;
	}

	.life-card img {
		width: 100%;
		height: auto;
		display: block;
	}

	.life-card figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 28px 10px 8px;
		font-size: 11px;
		letter-spacing: var(--track-nav);
		text-transform: uppercase;
		color: #f2f4f7;
		background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.55));
		opacity: 0;
		transition: opacity 0.25s ease;
	}

	.life-card:hover,
	.life-card:focus-within {
		transform: translateX(var(--shift, 0)) rotate(var(--rot, 0deg)) scale(1.02);
		z-index: 20;
	}

	.life-card:hover figcaption,
	.life-card:focus-within figcaption {
		opacity: 1;
	}

	.life-empty {
		max-width: 420px;
		margin: 18vh auto 0;
		padding-inline: 24px;
		text-align: center;
		font-size: 15px;
		line-height: 1.8;
		letter-spacing: 0.02em;
		color: rgba(242, 244, 247, 0.7);
	}

	/* —— Application profile brief —— */
	.profile-brief.mdsvex {
		max-width: 720px;
		--ink-body: color-mix(in srgb, var(--ink) 78%, transparent);
	}

	.profile-brief .profile-note {
		font-size: 13px;
		letter-spacing: 0.02em;
		color: var(--ink-soft);
		margin-bottom: 1.75rem;
	}

	.profile-brief table {
		font-size: 13px;
		display: block;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.spotlight {
		position: fixed;
		inset: 0;
		z-index: 400;
		pointer-events: none;
		opacity: 0;
		transition: opacity 1.1s ease;
		--x: 50vw;
		--y: 50vh;
		background: radial-gradient(
			circle 260px at var(--x) var(--y),
			rgba(0, 0, 0, 0) 0,
			rgba(0, 0, 0, 0) 60%,
			rgba(0, 0, 0, 0.55) 100%
		);
	}

	@media (max-width: 900px) {
		.life {
			columns: 180px 3;
		}
	}

	@media (max-width: 640px) {
		.page.life-page {
			padding-top: calc(clamp(28px, 5vw, 72px) + 72px);
		}

		.life {
			columns: 1;
			column-gap: 0;
			padding: 8px 12px 10vh;
			margin-inline: 0;
			max-width: none;
		}

		.life-card {
			transform: none;
			margin-bottom: 12px;
		}

		.life-card:hover,
		.life-card:focus-within {
			transform: none;
		}

		.life-card figcaption {
			opacity: 1;
			padding-top: 36px;
			background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.62));
		}

		.spotlight {
			display: none;
		}
	}

	@media (min-width: 641px) and (max-width: 900px) {
		.life {
			columns: 2;
			column-gap: 10px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.spotlight {
			display: none;
		}

		.life-card {
			animation: none;
			transform: none;
		}
	}
}

@layer utilities {
	.no-highlight {
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
	}

	.tnum {
		font-variant-numeric: tabular-nums;
	}

	.track-caps {
		letter-spacing: var(--track-caps);
	}

	.track-nav {
		letter-spacing: var(--track-nav);
	}

	.text-ink-70 {
		color: rgba(29, 31, 34, 0.85);
	}

	.dark .text-ink-70 {
		color: rgba(242, 244, 247, 0.82);
	}

	.text-ink-50 {
		color: var(--ink-soft);
	}

	.text-ink-30 {
		color: color-mix(in srgb, var(--ink) 32%, transparent);
	}
}

@keyframes page-fade {
	0% {
		opacity: 0;
	}
}

@keyframes cue-breathe {
	0%,
	100% {
		opacity: 0.15;
	}
	50% {
		opacity: 0.75;
	}
}

@media (max-width: 920px) {
	/* Name + socials on row 1; routes wrap on row 2. */
	.top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'name socials'
			'nav nav';
		align-items: center;
		column-gap: 12px;
		row-gap: 10px;
		padding-inline: 16px;
		padding-block: 12px 56px;
	}

	.top .name {
		grid-area: name;
		font-size: 13px;
		min-width: 0;
	}

	.top nav {
		grid-area: nav;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 10px 16px;
		font-size: 12px;
		letter-spacing: 0.08em;
		margin-left: 0;
	}

	.top .top-socials {
		grid-area: socials;
		margin-left: 0;
		padding-left: 0;
		border-left: 0;
		gap: 10px;
	}

	.top .icon-btn {
		padding: 2px;
	}

	.row {
		grid-template-columns: 3em 1fr;
	}

	.row .blurb,
	.row-thumb {
		display: none;
	}

	.hero-name {
		white-space: normal;
		font-size: clamp(42px, 14vw, 72px);
	}
}

@media (max-width: 640px) {
	.top {
		padding-inline: 14px;
		padding-block: 12px 48px;
		row-gap: 8px;
	}

	.top nav {
		gap: 8px 12px;
		font-size: 11px;
		row-gap: 6px;
	}

	.page:not(.life-page):not(.home) {
		padding-inline: 16px;
	}

	.essay-standfirst {
		font-size: 1.02rem;
	}
}

@media (max-width: 560px) {
	.about {
		grid-template-columns: 1fr;
		gap: 22px;
	}

	.about .headshot {
		order: -1;
	}
}

@media (max-width: 600px) {
	.row-thumb {
		display: none;
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	.page,
	.hero-down,
	.row,
	.row-thumb {
		animation: none !important;
		transition: none !important;
	}

	.hero-down {
		opacity: 0.5;
	}

	.hero-name {
		filter: blur(4px);
	}
}
