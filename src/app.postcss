/* Fonts are linked from app.html so they can preconnect and load in parallel. */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		/* Warm paper / ink palette. #fdfcfb on #1a180f. */
		--background: 30 33% 99%;
		--foreground: 45 27% 8%;
		--card: 30 33% 99%;
		--card-foreground: 45 27% 8%;
		--popover: 30 33% 99%;
		--popover-foreground: 45 27% 8%;
		--primary: 45 27% 8%;
		--primary-foreground: 30 33% 99%;
		--secondary: 40 14% 94%;
		--secondary-foreground: 45 27% 8%;
		--muted: 40 14% 94%;
		--muted-foreground: 45 8% 45%;
		--accent: 40 14% 94%;
		--accent-foreground: 45 27% 8%;
		--destructive: 0 72% 45%;
		--destructive-foreground: 30 33% 99%;
		--border: 40 12% 88%;
		--input: 40 12% 88%;
		--ring: 45 27% 8%;
		--radius: 0.375rem;

		--rule: 0 0 0;
		--surface: 40 16% 96%;
	}

	.dark {
		/* #161513 on #ece9e3. */
		--background: 40 7% 8%;
		--foreground: 40 19% 91%;
		--card: 40 7% 8%;
		--card-foreground: 40 19% 91%;
		--popover: 40 7% 8%;
		--popover-foreground: 40 19% 91%;
		--primary: 40 19% 91%;
		--primary-foreground: 40 7% 8%;
		--secondary: 40 6% 14%;
		--secondary-foreground: 40 19% 91%;
		--muted: 40 6% 14%;
		--muted-foreground: 40 8% 60%;
		--accent: 40 6% 14%;
		--accent-foreground: 40 19% 91%;
		--destructive: 0 62% 45%;
		--destructive-foreground: 40 19% 91%;
		--border: 40 6% 18%;
		--input: 40 6% 18%;
		--ring: 40 19% 91%;

		--rule: 255 255 255;
		--surface: 40 6% 11%;
	}
}

@layer base {
	* {
		@apply border-border;
	}

	html {
		scroll-behavior: smooth;
		/* Anchored headings should not hide under the sticky header. */
		scroll-padding-top: 6rem;
		-webkit-text-size-adjust: 100%;
	}

	body {
		@apply bg-background text-ink-70 antialiased;
		font-feature-settings: 'cv05' 1, 'cv08' 1, 'ss01' 1;
		text-rendering: optimizeLegibility;
		/* Barely-there paper depth — still reads as flat ink-on-paper. */
		background-image: radial-gradient(
			120% 80% at 50% -10%,
			hsl(var(--foreground) / 0.028),
			transparent 55%
		);
		background-attachment: fixed;
	}

	::selection {
		@apply bg-foreground/10;
	}

	:focus-visible {
		outline: 1.5px solid hsl(var(--foreground) / 0.35);
		outline-offset: 3px;
		border-radius: 2px;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		@apply text-foreground;
		text-wrap: balance;
	}
}

@layer components {
	/*
	 * The single link treatment used across the whole site: a hairline underline
	 * that only gains contrast on hover. Thickness eases in so the motion stays
	 * quiet — no colour flash, no slide.
	 */
	.link {
		@apply underline decoration-1 underline-offset-4;
		text-decoration-color: rgb(var(--rule) / 0.25);
		text-decoration-thickness: 1px;
		transition:
			text-decoration-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
			text-decoration-thickness 220ms cubic-bezier(0.22, 1, 0.36, 1),
			color 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.link:hover {
		text-decoration-color: rgb(var(--rule) / 0.65);
		text-decoration-thickness: 1.5px;
	}

	.link-quiet {
		@apply no-underline underline-offset-4;
		text-decoration-color: rgb(var(--rule) / 0.4);
		text-decoration-thickness: 1px;
		transition:
			text-decoration-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
			color 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.link-quiet:hover {
		text-decoration-line: underline;
		text-decoration-color: rgb(var(--rule) / 0.55);
	}

	.rule {
		@apply border-0 border-t;
		border-color: rgb(var(--rule) / 0.1);
	}

	/*
	 * List rows (posts, projects, updates): a 2px nudge on hover. Enough to
	 * feel alive, not enough to look like a card.
	 */
	.row-hover {
		transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.row-hover:hover {
		transform: translateX(2px);
	}

	.row-hover .row-meta {
		transition: color 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Nav items: active underline settles in rather than appearing. */
	.nav-link {
		@apply relative no-underline;
		transition: color 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left center;
		opacity: 0.45;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-link:hover::after,
	.nav-link[aria-current='page']::after {
		transform: scaleX(1);
	}

	.nav-link[aria-current='page']::after {
		opacity: 0.7;
	}
}

@layer utilities {
	.no-highlight {
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
	}

	/* Renders long numeric columns (dates, read times) with even spacing. */
	.tnum {
		font-variant-numeric: tabular-nums;
	}

	/*
	 * Entrance: opacity + 8px lift. Applied by the `reveal` action; the
	 * `.is-revealed` class flips the state once the element is on screen.
	 */
	.reveal {
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 520ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms),
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	.reveal.is-revealed {
		opacity: 1;
		transform: translateY(0);
	}
}

/* Soft cross-fade between pages — builds on the View Transitions API hook. */
@supports (view-transition-name: none) {
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 280ms;
		animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
	}

	::view-transition-old(page) {
		animation: page-out 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	::view-transition-new(page) {
		animation: page-in 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}
}

@keyframes page-out {
	to {
		opacity: 0;
		transform: translateY(-4px);
	}
}

@keyframes page-in {
	from {
		opacity: 0;
		transform: translateY(6px);
	}
}

@media (prefers-reduced-motion: reduce) {
	html {
		scroll-behavior: auto;
	}

	.reveal,
	.reveal.is-revealed,
	.row-hover,
	.row-hover .row-meta,
	.link,
	.link-quiet,
	.nav-link,
	.nav-link::after {
		transition: none !important;
		animation: none !important;
		transform: none !important;
		opacity: 1 !important;
	}

	@supports (view-transition-name: none) {
		::view-transition-old(root),
		::view-transition-new(root),
		::view-transition-old(page),
		::view-transition-new(page) {
			animation: none !important;
		}
	}
}
